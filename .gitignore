# ---- environment ----
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store

# ---- working dirs ----
.tmp/
.cache/

# ---- corpus: raw downloads are reproducible via `make corpus`; the registry carries sha256 ----
corpus/raw/
!corpus/raw/.gitkeep

# ---- model artefacts: keep the small GGUF + hashes + logs; exclude giant checkpoints ----
artifacts/*.pt
artifacts/*.gguf
artifacts/*.bin
artifacts/*.safetensors
artifacts/*-hf/
artifacts/checkpoints/
training/runs/*/ckpt-*.pt
training/runs/*/checkpoint*/

# ---- keep these though ----
!artifacts/*.json
!artifacts/*.png
!artifacts/*.svg

# ---- processed corpus: regenerate with `make corpus`; the compressed copy is committed so the
# ---- exact training text is recorded and hash-verifiable without a 40 MB blob in git history.
corpus/processed/corpus.jsonl
corpus/processed/text/

# ---- tokenised training cache: regenerated by train_pretrain.py (deterministic from corpus+tokenizer) ----
training/cache/
training/runs/*/ckpt*.pt

# ---- derived build artefacts (regenerated by the pipeline) ----
shennong/_build/
training/runs/*/hf/
models/baseline/

# merged corpus (reproducible from committed parts)
corpus/processed/corpus-full.jsonl
